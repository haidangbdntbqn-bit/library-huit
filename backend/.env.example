# Cổng chạy API
PORT=5000
# Chuỗi kết nối SQL Server (xem README mục "Kết nối SQL Server")
DATABASE_URL="sqlserver://localhost:1433;database=LibraryHUIT;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"
# Khóa ký JWT - đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET="doi-chuoi-bi-mat-nay"
JWT_EXPIRES_IN="7d"
# Cho phép web gọi API (nhiều địa chỉ cách nhau dấu phẩy, hoặc *)
CORS_ORIGIN="*"
# Địa chỉ Rasa server
RASA_URL="http://localhost:5005"
# Khóa nội bộ để Rasa action server gọi API (phải trùng với chatbot/.env)
INTERNAL_API_KEY="khoa-noi-bo-rasa"
TZ="Asia/Ho_Chi_Minh"
# Email nhắc hạn trả sách (gửi tự động mỗi ngày lúc REMINDER_HOUR giờ).
# Bỏ trống SMTP_HOST thì chỉ ghi nhật ký, không gửi thật. Gmail: smtp.gmail.com, 587, dùng "Mật khẩu ứng dụng".
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Thư viện HUIT <thuvien@example.edu.vn>"
REMINDER_HOUR=7
WEB_URL="http://localhost:5173"
